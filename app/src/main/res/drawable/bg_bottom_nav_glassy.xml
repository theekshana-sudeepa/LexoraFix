<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Transparent/Glassy White background -->
    <solid android:color="#E0FFFFFF" /> <!-- ~88% opacity white -->
    
    <!-- Very soft stroke for the "glass edge" reflection -->
    <stroke 
        android:width="0.5dp" 
        android:color="#4DFFFFFF" /> <!-- 30% white stroke -->
        
    <!-- Perfectly rounded corners -->
    <corners android:radius="40dp" />

</shape>
