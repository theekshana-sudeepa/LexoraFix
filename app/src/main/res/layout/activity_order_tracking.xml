<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Action Bar -->
    <include layout="@layout/layout_action_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Order ID & Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/tv_order_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Order #"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_status_badge"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="Confirmed"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="Order Progress"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <!-- Step 1: Confirmed -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_confirmed"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/textHint"
                            android:contentDescription="Confirmed" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Order Confirmed"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_step_confirmed_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your order has been received"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Line 1 -->
                    <View
                        android:id="@+id/line_confirmed_processing"
                        android:layout_width="3dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="19dp"
                        android:background="@color/textHint" />

                    <!-- Step 2: Processing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_processing"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/textHint"
                            android:contentDescription="Processing" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Processing"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_step_processing_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your order is being prepared"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Line 2 -->
                    <View
                        android:id="@+id/line_processing_shipped"
                        android:layout_width="3dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="19dp"
                        android:background="@color/textHint" />

                    <!-- Step 3: Shipped -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_shipped"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/textHint"
                            android:contentDescription="Shipped" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shipped"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_step_shipped_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="On the way to your address"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Line 3 -->
                    <View
                        android:id="@+id/line_shipped_delivered"
                        android:layout_width="3dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="19dp"
                        android:background="@color/textHint" />

                    <!-- Step 4: Delivered -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_delivered"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/textHint"
                            android:contentDescription="Delivered" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delivered"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_step_delivered_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Package delivered successfully"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tracking Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tracking_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Tracking Details"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/label_tracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracking Number"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_tracking_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/label_delivery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated Delivery"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_estimated_delivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_body"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Items List -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_order_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Purchased Items"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_order_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subtotal: "
                            android:textColor="@color/textSecondary"
                            android:textSize="@dimen/text_body" />
                        <TextView
                            android:id="@+id/tv_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 0.00"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>

                    <!-- Delivery Fee -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Fee: "
                            android:textColor="@color/textSecondary"
                            android:textSize="@dimen/text_body" />
                        <TextView
                            android:id="@+id/tv_delivery_fee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 0.00"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cardStroke"
                        android:layout_marginVertical="8dp" />

                    <!-- Grand Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total: "
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/text_subhead"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 0.00"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
