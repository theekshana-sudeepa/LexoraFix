<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════
                 HERO IMAGE AREA
                 ═══════════════════════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:background="@color/colorSurfaceVariant">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Subtle Gradient Overlays for Button Readability -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_gradient_top_shadow" />

                <!-- Top Bar: Back | Share + Wishlist -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Back Button (Glassmorphic Circle) -->
                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_button_dark"
                        android:elevation="2dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/cd_back" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Share Button -->
                    <ImageView
                        android:id="@+id/btn_share"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_icon_button_dark"
                        android:elevation="2dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_share"
                        app:tint="#FFFFFF"
                        android:contentDescription="Share product" />

                    <!-- Wishlist Heart -->
                    <ImageView
                        android:id="@+id/iv_wishlist"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_button_dark"
                        android:elevation="2dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="#FFFFFF"
                        android:contentDescription="Add to wishlist" />
                </LinearLayout>

                <!-- Video Play Overlay -->
                <ImageView
                    android:id="@+id/btn_play_video"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_primary"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/white"
                    android:visibility="gone"
                    android:contentDescription="@string/play_demo" />

                <!-- Image Position Indicator Pill -->
                <TextView
                    android:id="@+id/tv_image_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="36dp"
                    android:background="@drawable/bg_circle_semi_transparent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="1/1"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:elevation="2dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ═══════════════════════════════════════════
                 PRODUCT INFO SHEET (Curved Top)
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_rounded_surface"
                android:layout_marginTop="-28dp"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="16dp">

                <!-- Row: Price + Rating -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="LKR 0.00"
                            android:textColor="@color/colorPrimary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <!-- Original (crossed out) price shown by Java when variant has discount -->
                        <TextView
                            android:id="@+id/tv_original_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/textHint"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Compact Rating -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RatingBar
                            android:id="@+id/rating_bar_average"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:stepSize="0.1"
                            android:progressTint="#FFC107" />

                        <TextView
                            android:id="@+id/tv_rating_average"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppins"
                            android:text="(0)"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Product Name -->
                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins"
                    android:text="Product Name"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.15" />

                <!-- Stock Badge (Pill) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_stock"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_primary"
                        android:backgroundTint="@color/colorSuccess" />

                    <TextView
                        android:id="@+id/tv_stock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/in_stock"
                        android:textColor="@color/colorSuccess"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════
                 VARIANT SELECTORS (Chips, dynamically populated)
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_variants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_variant_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 QUANTITY + ADD TO CART CARD
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/layout_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins"
                        android:text="Quantity"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Rounded Stepper -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_qty_stepper"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_qty_minus"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="−"
                            android:textColor="@color/textPrimary"
                            android:textSize="20sp"
                            app:cornerRadius="10dp"
                            app:rippleColor="@color/ripple" />

                        <TextView
                            android:id="@+id/tv_quantity"
                            android:layout_width="44dp"
                            android:layout_height="36dp"
                            android:fontFamily="@font/poppins"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_qty_plus"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="@color/colorPrimary"
                            android:textSize="20sp"
                            app:cornerRadius="10dp"
                            app:rippleColor="@color/ripple" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 DESCRIPTION CARD
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="@string/description"
                        android:textColor="@color/textPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins"
                        android:text="Product description"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp" />

                    <!-- Video Demo Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_video"
                        style="@style/LexoraButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/play_demo"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 CUSTOMER REVIEWS CARD
                 ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/layout_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Customer Reviews"
                        android:textColor="@color/textPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_no_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins"
                        android:text="No reviews yet. Be the first to review!"
                        android:textColor="@color/textHint"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:visibility="gone" />

                    <!-- Write a Review Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_write_review"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="✍️  Write a Review"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/colorPrimary"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════
         STICKY BOTTOM ACTION BAR (Frosted Glass)
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar_frosted"
        android:elevation="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- Add to Cart (Outlined / Light) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_cart"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/poppins"
            android:text="@string/add_to_cart"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            app:cornerRadius="16dp"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1.5dp"
            app:rippleColor="@color/ripple"
            app:icon="@drawable/ic_cart"
            app:iconTint="@color/colorPrimary"
            app:iconGravity="textStart"
            app:iconSize="20dp" />

        <!-- Buy Now (Solid Primary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_buy_now"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.3"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/poppins"
            android:text="Buy Now"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="4dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
