<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AdminApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LexoraAdmin">

        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.WorkerRegistrationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LexoraAdmin" />
            
        <activity
            android:name=".activities.WorkerPendingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LexoraAdmin" />

        <activity
            android:name=".activities.WorkerDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LexoraAdmin" />

        <activity android:name=".activities.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".activities.ManageUsersActivity" android:exported="false" />
        <activity android:name=".activities.ManageOrdersActivity" android:exported="false" />
        <activity android:name=".activities.ManageBookingsActivity" android:exported="false" />
        <activity android:name=".activities.ManageProductsActivity" android:exported="false" />
        <activity android:name=".activities.AddEditProductActivity" android:exported="false" />
        <activity android:name=".activities.ManageCategoriesActivity" android:exported="false" />
        <activity android:name=".activities.AddEditCategoryActivity" android:exported="false" />
        <activity android:name=".activities.ManageServiceCentersActivity" android:exported="false" />
        <activity android:name=".activities.AddEditServiceCenterActivity" android:exported="false" />
        <activity android:name=".activities.OrderDetailActivity" android:exported="false" />
        <activity android:name=".activities.AdminProductReviewsActivity" android:exported="false" />
        <activity android:name=".activities.AdminSettingsActivity" android:exported="false" />
        <activity android:name=".activities.MaintenanceActivity" android:exported="false" />
        <activity android:name=".activities.WorkerChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".services.AdminOrderListenerService"
            android:exported="false" />

        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase Cloud Messaging Defaults -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_email" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="lexorafix_admin_notifications" />

    </application>
</manifest>
