<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Admin Dark Premium Theme -->
    <style name="Theme.LexoraAdmin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Global Font -->
        <item name="android:fontFamily">@font/poppins</item>

        <item name="colorPrimary">@color/adminPrimary</item>
        <item name="colorPrimaryVariant">@color/adminPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/adminSecondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/adminBackground</item>
        <item name="colorSurface">@color/adminSurface</item>
        <item name="colorOnSurface">@color/adminTextPrimary</item>
        <item name="colorError">@color/adminError</item>
        <item name="android:statusBarColor">@color/adminBackground</item>
        <item name="android:navigationBarColor">@color/adminSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="O_MR1">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:textColorPrimary">@color/adminTextPrimary</item>
        <item name="android:textColorSecondary">@color/adminTextSecondary</item>
        <item name="android:textColorHint">@color/adminTextHint</item>
        <item name="colorControlHighlight">@color/adminRipple</item>
    </style>

    <!-- Admin Button Styles -->
    <style name="AdminButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/adminPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="AdminButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/adminPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="strokeColor">@color/adminPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Admin Card Style -->
    <style name="AdminCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/adminCardBackground</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Admin TextInput Style -->
    <style name="AdminTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">@color/adminPrimary</item>
        <item name="hintTextColor">@color/adminPrimary</item>
        <item name="boxBackgroundColor">#0DFFFFFF</item>
    </style>

    <!-- ========== Admin Navigation Drawer Style ========== -->
    <style name="AdminNavDrawerStyle" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">#1E293B</item>
        <item name="itemTextColor">#CBD5E1</item>
        <item name="itemIconTint">#CBD5E1</item>
        <item name="itemShapeFillColor">@color/admin_nav_item_bg</item>
        <item name="itemShapeAppearanceOverlay">@style/AdminNavDrawerShape</item>
    </style>

    <style name="AdminNavDrawerShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
