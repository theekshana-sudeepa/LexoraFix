<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#0F172A">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Deep Gradient Header -->
            <LinearLayout
                android:id="@+id/ll_dashboard_header"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/gradient_admin_toolbar"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_menu"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Menu"
                        android:padding="4dp"
                        android:src="@drawable/ic_menu"
                        app:tint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:letterSpacing="0.02"
                            android:text="Dashboard"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins"
                            android:text="Welcome to LexoraFix Admin"
                            android:textColor="#E2E8F0"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Overlapping Card: Total Revenue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_revenue_hero"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-60dp"
                app:cardBackgroundColor="#10B981"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/ll_dashboard_header"
                app:strokeWidth="0dp">

                <!-- Subtle Background Glow/Gradient could go here natively, but flat rich color works too -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="end|bottom"
                    android:translationX="60dp"
                    android:translationY="60dp"
                    android:background="@drawable/bg_glow_blue"
                    android:alpha="0.2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Total Generated Revenue"
                        android:textColor="#D1FAE5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tv_total_revenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/poppins"
                        android:text="LKR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Title: Overview -->
            <TextView
                android:id="@+id/tv_overview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins"
                android:text="Overview"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_revenue_hero" />

            <!-- Horizontal Scroll Metrics -->
            <HorizontalScrollView
                android:id="@+id/hsv_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tv_overview_title">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Users -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_users"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_dashboard_users_premium"
                                app:tint="#818CF8" />

                            <TextView
                                android:id="@+id/tv_total_users"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins"
                                android:text="--"
                                android:textColor="#F8FAFC"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Users"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Orders -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_orders"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_dashboard_orders_premium"
                                app:tint="#FBBF24" />

                            <TextView
                                android:id="@+id/tv_total_orders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins"
                                android:text="--"
                                android:textColor="#F8FAFC"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Orders"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bookings -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_bookings"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_dashboard_bookings_premium"
                                app:tint="#34D399" />

                            <TextView
                                android:id="@+id/tv_total_bookings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins"
                                android:text="--"
                                android:textColor="#F8FAFC"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Bookings"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Products -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_products"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_dashboard_products_premium"
                                app:tint="#F472B6" />

                            <TextView
                                android:id="@+id/tv_total_products"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins"
                                android:text="--"
                                android:textColor="#F8FAFC"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Products"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Categories -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_categories"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#1E293B"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_dashboard_categories_premium"
                                app:tint="#38BDF8" />

                            <TextView
                                android:id="@+id/tv_total_categories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins"
                                android:text="--"
                                android:textColor="#F8FAFC"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Categories"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Low Stock Alert -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#7F1D1D"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="⚠️"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tv_low_stock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/poppins"
                                android:text="--"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:text="Low Stock"
                                android:textColor="#FCA5A5"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section Title: Quick Actions -->
            <TextView
                android:id="@+id/tv_quick_actions_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/poppins"
                android:text="Quick Actions"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hsv_metrics" />

            <!-- Vertical Quick Actions List (Sleek Pills) -->
            <LinearLayout
                android:id="@+id/ll_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_quick_actions_title">

                <!-- Creation Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_add_product"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Add Product"
                        android:textAllCaps="false"
                        android:textColor="#F472B6"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_products_premium"
                        app:iconTint="#F472B6"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_add_category"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Add Category"
                        android:textAllCaps="false"
                        android:textColor="#38BDF8"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_categories_premium"
                        app:iconTint="#38BDF8"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Management Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_manage_orders"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Orders"
                        android:textAllCaps="false"
                        android:textColor="#FBBF24"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_orders_premium"
                        app:iconTint="#FBBF24"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_manage_bookings"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Bookings"
                        android:textAllCaps="false"
                        android:textColor="#34D399"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_bookings_premium"
                        app:iconTint="#34D399"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_manage_products"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Manage Products"
                        android:textAllCaps="false"
                        android:textColor="#A78BFA"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_store"
                        app:iconTint="#A78BFA"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_manage_users"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Users"
                        android:textAllCaps="false"
                        android:textColor="#818CF8"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_users_premium"
                        app:iconTint="#818CF8"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_manage_service_centers"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Service Centers"
                        android:textAllCaps="false"
                        android:textColor="#C084FC"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_centers_premium"
                        app:iconTint="#C084FC"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qa_migrate_data"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Migrate Data"
                        android:textAllCaps="false"
                        android:textColor="#F59E0B"
                        app:backgroundTint="#1F1E293B"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_dashboard_migrate_premium"
                        app:iconTint="#F59E0B"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Spacer & Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="@font/poppins"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.05"
                android:text="Sign Out Safely"
                android:textAllCaps="false"
                android:textColor="#FCA5A5"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_quick_actions"
                app:strokeColor="#334155"
                app:strokeWidth="1dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_admin"
        style="@style/AdminNavDrawerStyle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_admin"
        app:menu="@menu/menu_admin_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
