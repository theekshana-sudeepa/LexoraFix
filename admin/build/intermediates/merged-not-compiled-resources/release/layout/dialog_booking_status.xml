<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/adminCardBackground"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/adminDivider"
        android:layout_marginBottom="24dp" />

    <TextView
        android:fontFamily="@font/poppins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Status"
        android:textColor="@color/adminTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:fontFamily="@font/poppins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select the current progress state for this booking."
        android:textColor="@color/adminTextSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/ll_worker_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:background="#1A3B82F6"
        android:padding="16dp"
        app:cornerRadius="12dp">
        
        <TextView
            android:fontFamily="@font/poppins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned Worker Details"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"/>
            
        <TextView
            android:id="@+id/tv_dialog_worker_name"
            android:fontFamily="@font/poppins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Loading..."
            android:textColor="@color/adminTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/tv_dialog_worker_phone"
            android:fontFamily="@font/poppins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: Loading..."
            android:textColor="@color/adminTextSecondary"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Progress bar for loading worker info -->
    <ProgressBar
        android:id="@+id/pb_worker_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="#3B82F6"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ll_status_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
        
</LinearLayout>
