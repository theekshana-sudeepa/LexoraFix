rules_version = '2';

// =============================================================
// LexoraFix Firestore Security Rules
// =============================================================
// DEPLOY INSTRUCTIONS:
// 1. Go to Firebase Console → Firestore Database → Rules
// 2. Replace ALL existing rules with this content
// 3. Click "Publish"
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isWorker() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "worker";
    }

    // ----- Users -----
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ----- Products (auth users read & update stock, admin full writes) -----
    match /products/{productId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow write: if isAdmin();
      
      // Allow customers to leave reviews
      match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      }
    }

    // ----- Categories (auth users read, admin writes) -----
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ----- Service Centers (auth users read, admin writes) -----
    match /service_centers/{centerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ----- Top-level Orders -----
    // Customers can CREATE orders (dual-write from checkout)
    // Customers can read/update THEIR OWN orders (matched by firebaseUid field)
    // Admins can do everything
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (isAdmin() || resource.data.firebaseUid == request.auth.uid);
      allow update: if isAdmin();
    }

    // ----- Top-level Bookings -----
    // Customers can CREATE bookings
    // Workers can READ all bookings (to see available jobs) and UPDATE bookings (to accept/change status)
    // Admins can do everything
    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (isAdmin() || isWorker() || resource.data.firebaseUid == request.auth.uid);
      allow update: if isAdmin() || isWorker();
    }

    // ----- User subcollection orders -----
    match /users/{uid}/orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ----- User subcollection bookings -----
    match /users/{uid}/bookings/{bookingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ----- Collection group queries (for admin) -----
    match /{path=**}/bookings/{bookingId} {
      allow read: if isAdmin();
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // ----- System Settings -----
    match /system/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
